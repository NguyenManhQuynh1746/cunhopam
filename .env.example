# Bỏ qua cảnh báo patch lockfile của Next.js trên Windows/Node 24
NEXT_IGNORE_INCORRECT_LOCKFILE=1

# Cấu hình Supabase Client (Có thể công khai trên client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (BÍ MẬT - CHỈ DÙNG CHO SCRIPT IMPORT / SERVER - KHÔNG COMMIT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Khóa bí mật băm viewer IP + User-Agent bảo vệ tính lượt xem (BÍ MẬT - SERVER ONLY)
VIEW_HASH_SECRET=your-random-secret-salt-here

