{title: Ước Gì (Ông Ngoại Tuổi 30 Ost)}
{artist: Mỹ Tâm}
{key: G}
{rhythm: Ballad}
{genre: Nhạc Trẻ}
{license: user_submitted}
{rights_holder: Mỹ Tâm}
